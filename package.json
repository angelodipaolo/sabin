{
  "name": "sabin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "test": "lerna run test",
    "lint": "lerna run lint",
    "typecheck": "lerna run typecheck",
    "package:vscode": "cd packages/vscode-extension && npx @vscode/vsce package",
    "package:cli": "cd packages/cli && npm pack",
    "install:sabin": "node scripts/install.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "lerna": "^10.0.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "js-yaml@^4": "^4.3.1",
    "nx": {
      "brace-expansion": "^5.0.9"
    }
  }
}
