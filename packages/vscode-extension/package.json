{
  "name": "sabin-vscode",
  "displayName": "Sabin Workflow Manager",
  "description": "Workflow management for agentic coding",
  "version": "0.1.0",
  "publisher": "angelodipaolo",
  "repository": {
    "type": "git",
    "url": "https://github.com/angelodipaolo/sabin.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sabin.newTask",
        "title": "Sabin: New Task",
        "icon": "$(add)"
      },
      {
        "command": "sabin.refreshTasks",
        "title": "Sabin: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sabin.gotoTask",
        "title": "Sabin: Go to Task",
        "icon": "$(search)"
      },
      {
        "command": "sabin.showIndex",
        "title": "Sabin: All Tasks",
        "icon": "$(arrow-left)"
      },
      {
        "command": "sabin.setStatus",
        "title": "Sabin: Set Status",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "sabin.openTask",
        "title": "Sabin: Open Task File",
        "icon": "$(checklist)"
      },
      {
        "command": "sabin.openPlan",
        "title": "Sabin: Open Plan",
        "icon": "$(book)"
      },
      {
        "command": "sabin.openPrompt",
        "title": "Sabin: Open Prompt Scratchpad",
        "icon": "$(edit)"
      },
      {
        "command": "sabin.openWorktree",
        "title": "Sabin: Open Worktree in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sabin.newNote",
        "title": "Sabin: New Note",
        "icon": "$(new-file)"
      },
      {
        "command": "sabin.renameNote",
        "title": "Rename...",
        "icon": "$(edit)"
      },
      {
        "command": "sabin.deleteNote",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "sabin.revealNote",
        "title": "Reveal in Explorer",
        "icon": "$(folder)"
      },
      {
        "command": "sabin.copyTicket",
        "title": "Sabin: Copy Ticket",
        "icon": "$(tag)"
      },
      {
        "command": "sabin.copyPath",
        "title": "Sabin: Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "sabin.openProjectWorkspace",
        "title": "Sabin: Reopen as Sabin Workspace",
        "icon": "$(window)"
      },
      {
        "command": "sabin.gotoAgent",
        "title": "Sabin: Go to Agent",
        "icon": "$(target)"
      },
      {
        "command": "sabin.openTerminal",
        "title": "Sabin: Open Terminal in Worktree",
        "icon": "$(terminal)"
      }
    ],
    "configuration": {
      "title": "Sabin",
      "properties": {
        "sabin.revealOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the Sabin sidebar when a Sabin project opens, so `sabin open` lands on it."
        },
        "sabin.cliPath": {
          "type": "string",
          "default": "sabin",
          "description": "Path to the sabin CLI, used for Open in iTerm2. Only `jump` and `term` are ever run."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sabin",
          "title": "Sabin",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sabin": [
        {
          "type": "webview",
          "id": "sabin.indexView",
          "name": "Tasks",
          "when": "!sabin.detail"
        },
        {
          "id": "sabin.detailView",
          "name": "Task",
          "when": "sabin.detail"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sabin.newTask",
          "when": "view == sabin.indexView",
          "group": "navigation@0"
        },
        {
          "command": "sabin.gotoTask",
          "when": "view == sabin.indexView",
          "group": "navigation@1"
        },
        {
          "command": "sabin.refreshTasks",
          "when": "view == sabin.indexView",
          "group": "navigation@2"
        },
        {
          "command": "sabin.showIndex",
          "when": "view == sabin.detailView",
          "group": "navigation@0"
        },
        {
          "command": "sabin.gotoAgent",
          "when": "view == sabin.detailView && sabin.detailHasAgent",
          "group": "navigation@1"
        },
        {
          "command": "sabin.openTerminal",
          "when": "view == sabin.detailView && sabin.detailHasWorktree",
          "group": "navigation@2"
        },
        {
          "command": "sabin.newNote",
          "when": "view == sabin.detailView",
          "group": "navigation@3"
        },
        {
          "command": "sabin.setStatus",
          "when": "view == sabin.detailView",
          "group": "1_task@0"
        },
        {
          "command": "sabin.openWorktree",
          "when": "view == sabin.detailView && sabin.detailHasWorktree",
          "group": "1_task@1"
        },
        {
          "command": "sabin.copyTicket",
          "when": "view == sabin.detailView",
          "group": "1_task@2"
        },
        {
          "command": "sabin.refreshTasks",
          "when": "view == sabin.detailView",
          "group": "9_refresh@0"
        }
      ],
      "view/item/context": [
        {
          "command": "sabin.gotoAgent",
          "when": "view == sabin.detailView && viewItem == sabinSession",
          "group": "inline@0"
        },
        {
          "command": "sabin.revealNote",
          "when": "view == sabin.detailView && viewItem =~ /^sabin(Note|NotesDir|TaskFile|Prompt)$/",
          "group": "5_reveal@0"
        },
        {
          "command": "sabin.copyPath",
          "when": "view == sabin.detailView && viewItem =~ /^sabin(Note|NotesDir|TaskFile|Prompt)$/",
          "group": "5_reveal@1"
        },
        {
          "command": "sabin.renameNote",
          "when": "view == sabin.detailView && viewItem =~ /^sabin(Note|NotesDir)$/",
          "group": "7_modification@0"
        },
        {
          "command": "sabin.deleteNote",
          "when": "view == sabin.detailView && viewItem =~ /^sabin(Note|NotesDir)$/",
          "group": "7_modification@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sabin.renameNote",
          "when": "false"
        },
        {
          "command": "sabin.deleteNote",
          "when": "false"
        },
        {
          "command": "sabin.revealNote",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sabin.gotoTask",
        "key": "alt+cmd+t",
        "mac": "alt+cmd+t",
        "win": "alt+ctrl+t",
        "linux": "alt+ctrl+t"
      },
      {
        "command": "sabin.openPrompt",
        "key": "alt+cmd+p",
        "mac": "alt+cmd+p",
        "win": "alt+ctrl+p",
        "linux": "alt+ctrl+p"
      },
      {
        "command": "sabin.openPlan",
        "key": "alt+cmd+l",
        "mac": "alt+cmd+l",
        "win": "alt+ctrl+l",
        "linux": "alt+ctrl+l"
      },
      {
        "command": "sabin.renameNote",
        "key": "f2",
        "when": "focusedView == sabin.detailView"
      },
      {
        "command": "sabin.deleteNote",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sabin.detailView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "pretest": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sabin/core": "^0.1.0",
    "@vscode/codicons": "^0.0.40"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.0",
    "esbuild": "^0.25.10",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.0.0"
  }
}
