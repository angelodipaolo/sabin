{
  "name": "sabin-vscode",
  "displayName": "Sabin Workflow Manager",
  "description": "Workflow management for agentic coding",
  "version": "0.1.0",
  "publisher": "angelodipaolo",
  "repository": {
    "type": "git",
    "url": "https://github.com/angelodipaolo/sabin.git",
    "directory": "packages/vscode-extension"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sabin.newTask",
        "title": "Sabin: New Task",
        "icon": "$(add)"
      },
      {
        "command": "sabin.refreshTasks",
        "title": "Sabin: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sabin.focusTask",
        "title": "Sabin: Focus Task",
        "icon": "$(target)"
      },
      {
        "command": "sabin.openTask",
        "title": "Sabin: Open Task File",
        "icon": "$(checklist)"
      },
      {
        "command": "sabin.openPlan",
        "title": "Sabin: Open Plan",
        "icon": "$(book)"
      },
      {
        "command": "sabin.openPrompt",
        "title": "Sabin: Open Prompt Scratchpad",
        "icon": "$(edit)"
      },
      {
        "command": "sabin.openWorktree",
        "title": "Sabin: Open Worktree in New Window",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sabin.newNote",
        "title": "Sabin: New Note",
        "icon": "$(new-file)"
      },
      {
        "command": "sabin.unpinTask",
        "title": "Sabin: Follow Current Branch",
        "icon": "$(pinned)"
      },
      {
        "command": "sabin.copyTicket",
        "title": "Sabin: Copy Ticket",
        "icon": "$(tag)"
      },
      {
        "command": "sabin.copyPath",
        "title": "Sabin: Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "sabin.openProjectWorkspace",
        "title": "Sabin: Reopen as Sabin Workspace",
        "icon": "$(window)"
      },
      {
        "command": "sabin.openInITerm",
        "title": "Sabin: Open in iTerm2",
        "icon": "$(terminal)"
      }
    ],
    "configuration": {
      "title": "Sabin",
      "properties": {
        "sabin.revealOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Reveal the Sabin sidebar when a Sabin project opens, so `sabin open` lands on it."
        },
        "sabin.cliPath": {
          "type": "string",
          "default": "sabin",
          "description": "Path to the sabin CLI, used for Open in iTerm2. Only `jump` and `term` are ever run."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sabin",
          "title": "Sabin",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sabin": [
        {
          "id": "sabin.workspaceView",
          "name": "Workspace"
        },
        {
          "type": "webview",
          "id": "sabin.tasksView",
          "name": "Board"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sabin.newNote",
          "when": "view == sabin.workspaceView",
          "group": "navigation@0"
        },
        {
          "command": "sabin.focusTask",
          "when": "view == sabin.workspaceView",
          "group": "navigation@1"
        },
        {
          "command": "sabin.unpinTask",
          "when": "view == sabin.workspaceView",
          "group": "navigation@2"
        },
        {
          "command": "sabin.refreshTasks",
          "when": "view == sabin.workspaceView",
          "group": "navigation@3"
        },
        {
          "command": "sabin.newTask",
          "when": "view == sabin.tasksView",
          "group": "navigation"
        },
        {
          "command": "sabin.refreshTasks",
          "when": "view == sabin.tasksView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sabin.copyTicket",
          "when": "view == sabin.workspaceView && viewItem == sabinTask",
          "group": "inline@0"
        },
        {
          "command": "sabin.copyTicket",
          "when": "view == sabin.workspaceView && viewItem == sabinFocused",
          "group": "sabin@0"
        },
        {
          "command": "sabin.copyPath",
          "when": "view == sabin.workspaceView && viewItem =~ /^sabin(Note|NotesDir|Task|Focused)$/",
          "group": "sabin@1"
        },
        {
          "command": "sabin.newNote",
          "when": "view == sabin.workspaceView && viewItem == sabinFocused",
          "group": "inline@1"
        },
        {
          "command": "sabin.openPlan",
          "when": "view == sabin.workspaceView && viewItem == sabinFocused",
          "group": "inline@2"
        },
        {
          "command": "sabin.openWorktree",
          "when": "view == sabin.workspaceView && viewItem == sabinFocused",
          "group": "inline@3"
        },
        {
          "command": "sabin.openInITerm",
          "when": "view == sabin.workspaceView && viewItem == sabinFocused",
          "group": "inline@0"
        },
        {
          "command": "sabin.openInITerm",
          "when": "view == sabin.workspaceView && viewItem == sabinTask",
          "group": "inline@0"
        },
        {
          "command": "sabin.openInITerm",
          "when": "view == sabin.workspaceView && viewItem == sabinSession",
          "group": "inline@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sabin.focusTask",
        "key": "alt+cmd+t",
        "mac": "alt+cmd+t",
        "win": "alt+ctrl+t",
        "linux": "alt+ctrl+t"
      },
      {
        "command": "sabin.openPrompt",
        "key": "alt+cmd+p",
        "mac": "alt+cmd+p",
        "win": "alt+ctrl+p",
        "linux": "alt+ctrl+p"
      },
      {
        "command": "sabin.openPlan",
        "key": "alt+cmd+l",
        "mac": "alt+cmd+l",
        "win": "alt+ctrl+l",
        "linux": "alt+ctrl+l"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "pretest": "npm run compile",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm run package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sabin/core": "^0.1.0",
    "@vscode/codicons": "^0.0.40"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.3.0",
    "esbuild": "^0.25.10",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.4",
    "typescript": "^5.0.0"
  }
}
